# ============================================================
# STB StageConnect — .gitignore
# ============================================================

# ---- Java / Maven ----
**/target/
*.class
*.jar
*.war
*.ear
*.log
*.err
mvnw
mvnw.cmd
.mvn/wrapper/maven-wrapper.jar

# ---- .NET ----
**/bin/
**/obj/
*.user
*.suo
*.ncrunchsolution
*.ncrunchproject
.vs/
*.DotSettings.user
# Keep .csproj and .sln tracked
!**/*.csproj
!**/*.sln

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp
*.swo
*.orig
*.bak

# ---- Angular / Node ----
**/node_modules/
**/dist/
**/.angular/
.npm/
*.tsbuildinfo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---- Environment & Secrets ----
.env
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---- Local TLS certificates (generated by scripts/generate-dev-certs.sh) ----
nginx/certs/

# ---- Local DB dumps ----
backups/

# ---- Uploaded files (dev only) ----
uploads/

# ---- Test results & coverage ----
**/TestResults/
**/coverage/
**/lcov.info
*.trx
*.coveragexml

# ---- AI Agent / IDE plugin metadata ----
.agents/
.claude/
**/.agents/
**/.claude/
skills-lock.json
**/skills-lock.json
.gemini/
